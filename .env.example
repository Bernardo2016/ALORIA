# Copia este archivo como .env y completa tus credenciales reales
PORT=3000

# Configuración MySQL (Local o Nube: Aiven / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=hotel_aloria

# Activar SSL en producción para bases de datos en la nube (true / false)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
